{
    "border-radius": {
        "description": [
            "Adds border-radius style with a value between an upper and a lower bound.",
            ""
        ],
        "parameters": {
            "radius": {
                "description": [
                    "The preferred value."
                ]
            },
            "min": {
                "description": [
                    "The minimum value."
                ]
            },
            "max": {
                "description": [
                    "The maximum allowed value."
                ]
            }
        },
        "example": [
            {
                "code": [
                    ".my-component {",
                    "  @include border-radius(10px, 5px, 20px);",
                    "}"
                ]
            }
        ]
    },
    "line-clamp": {
        "description": [
            "Truncates text to a specific number of lines.",
            ""
        ],
        "parameters": {
            "lines": {
                "description": [
                    "The number of lines to show"
                ]
            },
            "inline": {
                "description": [
                    "Sets whether an element displays inline-box or box"
                ]
            },
            "vertical": {
                "description": [
                    "Sets whether an element lays out its contents horizontally or vertically"
                ]
            }
        },
        "example": [
            {
                "description": [
                    "Truncates text after the fourth line"
                ],
                "code": [
                    "@include line-clamp(4, true, true);"
                ]
            }
        ]
    },
    "ellipsis": {
        "description": [
            "Applies text-overflow ellipsis to e text element.",
            "This won't work on display flex elements.",
            ""
        ],
        "example": [
            {
                "code": [
                    ".my-class {",
                    "  @include ellipsis();",
                    "}"
                ]
            }
        ]
    },
    "hide-default": {
        "description": [
            "Hides the element from the DOM.",
            ""
        ],
        "example": [
            {
                "description": [
                    "Sample usage"
                ],
                "code": [
                    "input[type=\"checkbox\"] {",
                    "  @include hide-default();",
                    "}"
                ]
            }
        ]
    }
}